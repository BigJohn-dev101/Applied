generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  wishlist
  applied
  interview
  offer
  closed
}

model Application {
  id        String   @id @default(cuid())
  company   String
  role      String
  link      String?
  dateSent  DateTime @db.Date
  stage     Stage    @default(wishlist)
  notes     String?
  createdAt DateTime @default(now())

  @@index([stage])
  @@index([createdAt])
}
